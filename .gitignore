paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.toc
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
paper/**/*.bbl
paper/**/*.blg
paper/**/*.xdv

# Result files (JSON / JSONL) are evidence and are NOT ignored.
